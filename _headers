# HTML revalidates; stale copies remain available during origin failures.
/
  Cache-Control: public, max-age=0, stale-while-revalidate=600, stale-if-error=86400
/bypo
  Cache-Control: public, max-age=0, stale-while-revalidate=600, stale-if-error=86400
# Version asset filenames whenever content changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/covers/*
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=604800
